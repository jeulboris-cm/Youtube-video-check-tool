# Copy to .env for running on your own computer. On GitHub, set these as
# repository secrets instead (see README.md).

# Required: Claude API key (console.anthropic.com).
ANTHROPIC_API_KEY=
# Strongly recommended: YouTube Data API key. Without it the agent only has
# news and web search, so it cannot measure demand or saturation on YouTube.
YOUTUBE_API_KEY=

# Optional: which Claude model and how hard it thinks (low, medium, high).
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Optional: most YouTube quota units one weekly run may spend (default 2500 of
# the free 10,000 a day).
RADAR_YOUTUBE_UNITS=

# Optional: email the weekly recap through any SMTP service (Brevo, Gmail with
# an app password, ...). Leave empty to skip email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
RADAR_EMAIL_TO=
