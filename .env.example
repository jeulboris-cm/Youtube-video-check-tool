# Copy this file to .env and fill in values as later steps need them.
PORT=3000
# Folder for saved data when no database is set (default: ./data)
DATA_DIR=
# Postgres address (for example from Neon). Needed on hosts that wipe their disk,
# like Render's free plan. When set, data is stored there instead of DATA_DIR.
DATABASE_URL=
# Step 3: YouTube Data API key
# Daily safety limit on YouTube quota units (default 8000 of ~10000)
YOUTUBE_DAILY_UNIT_CAP=
YOUTUBE_API_KEY=
# Step 5: Claude API key
ANTHROPIC_API_KEY=
# How hard Claude thinks per report: low, medium (default) or high. Higher costs more.
CLAUDE_EFFORT=
# Step 7: 30-day reminder emails, through any SMTP service (Brevo, Resend, Gmail
# with an app password, ...). Leave empty to turn reminders off.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# The site's public address, used for the link in reminder emails (Render sets it).
PUBLIC_URL=
# Password the daily reminder job sends to /api/cron/reminders.
CRON_SECRET=
# Password for the private owner page (/admin.html). Leave empty to switch it off.
ADMIN_PASSWORD=
